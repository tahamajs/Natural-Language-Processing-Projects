   "source": [
    "# تمرین ۵ - بخش دوم: تراول‌بات (مکمل شده با mocks)\n",
    "\n",
    "این نوت‌بوک با استفاده از mocks/fallbacks تکمیل شده است تا بدون نیاز به API Keyهای خارجی قابل اجرا باشد. کدهای مربوط به دانلود داده‌ها، تبدیل به embedding و ابزارها به صورت محاوره‌ای (mock) پیاده‌سازی شده‌اند.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "%pip install -r requirements.txt --quiet\n",
    "import os\n",
    "import json\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from datetime import datetime, timedelta\n",
    "import hashlib\n",
    "print('Imports done')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## API keys (mocks)\n",
    "\n",
    "ما از mocks استفاده می‌کنیم؛ در صورت داشتن کلیدها می‌توانید مقادیر را جایگزین کنید.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "os.environ['GOOGLE_API_KEY'] = os.environ.get('GOOGLE_API_KEY', 'MOCK_GOOGLE')\n",
    "os.environ['TAVILY_API_KEY'] = os.environ.get('TAVILY_API_KEY', 'MOCK_TAVILY')\n",
    "os.environ['AMADEUS_CLIENT_ID'] = os.environ.get('AMADEUS_CLIENT_ID', 'MOCK_AMADEUS_ID')\n",
    "os.environ['AMADEUS_CLIENT_SECRET'] = os.environ.get('AMADEUS_CLIENT_SECRET', 'MOCK_AMADEUS_SECRET')\n",
    "print('Mock API keys set')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## بخش مجموعه‌داده‌ها: IATA و Currency و FAQ\n",
    "کدها طوری نوشته شده‌اند که اگر داده‌های محلی یافت نشد، از داده‌های نمونه (mock) استفاده کنند.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# IATA mapping: try to load dataset if present, otherwise use sample mapping\n",
    "data_dir = './data'\n",
    "os.makedirs(data_dir, exist_ok=True)\n",
    "city_to_iata = {}\n",
    "try:\n",
    "    iata_path = './data/iata-airport-code/iata-airport-codes.csv'\n",
    "    if os.path.exists(iata_path):\n",
    "        iata_df = pd.read_csv(iata_path)\n",
    "        for _, r in iata_df.iterrows():\n",
    "            city = str(r.get('city', '')).strip().lower()\n",
    "            code = str(r.get('iata_code', '')).strip().upper()\n",
    "            if city and code and code != 'nan':\n",
    "                city_to_iata.setdefault(city, code)\n",
    "    else:\n",
    "        raise FileNotFoundError\n",
    "except Exception:\n",
    "    # fallback sample mapping\n",
    "    sample = {'dubai':'DXB','tehran':'IKA','london':'LON','paris':'CDG','new york':'JFK'}\n",
    "    city_to_iata.update(sample)\n",
    "print('city_to_iata sample:', list(city_to_iata.items())[:5])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Currency mapping: try to load dataset if present, otherwise use sample mapping\n",
    "country_to_currency = {}\n",
    "try:\n",
    "    curr_path = './data/currency-and-country-code-mapping/currency_country_code.csv'\n",
    "    if os.path.exists(curr_path):\n",
    "        curr_df = pd.read_csv(curr_path)\n",
    "        for _, r in curr_df.iterrows():\n",
    "            country = str(r.get('Country','')).strip().lower()\n",
    "            code = str(r.get('CurrencyCode','')).strip().upper()\n",
    "            if country and code and code != 'nan':\n",
    "                country_to_currency[country]=code\n",
    "    else:\n",
    "        raise FileNotFoundError\n",
    "except Exception:\n",
    "    sample_c = {'iran':'IRR','uae':'AED','united states':'USD','france':'EUR','uk':'GBP'}\n",
    "    country_to_currency.update(sample_c)\n",
    "print('country_to_currency sample:', list(country_to_currency.items())[:5])\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Load FAQ from FAQ.js (robust parser)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "faq_path = './FAQ.js'\n",
    "faqs = []\n",
    "try:\n",
    "    with open(faq_path, 'r', encoding='utf-8') as f:\n",
    "        text = f.read().strip()\n",
    "    # try JSON load\n",
    "    try:\n",
    "        data = json.loads(text)\n",
    "        if isinstance(data, list):\n",
    "            faqs = data\n",
    "    except Exception:\n",
    "        # try to extract question/answer pairs via simple parsing\n",
    "        import re\n",
    "        pairs = re.findall(r'\{\\s*"question"\s*:\s*"([^"]+)"\s*,\\s*"answer"\s*:\s*"([^"]+)"', text)\n",
    "        for q,a in pairs:\n",
    "            faqs.append({'question':q,'answer':a})\n",
    "except FileNotFoundError:\n",
    "    # fallback sample faqs\n",
    "    faqs = [\n",
    "        {'question':'What documents do I need for international travel?','answer':'You need passport, visa if required, travel insurance and return ticket.'},\n",
    "        {'question':'How early should I arrive at the airport?','answer':'International: 3 hours, Domestic: 2 hours.'},\n",
    "    ]\n",
    "print('Loaded', len(faqs), 'FAQ entries')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Parse World Travel Book (mock extraction)" 
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# We'll create a small dataframe of travel highlights as mock parsed content\n",
    "travel_texts = [\n",
    "    {'title':'Eiffel Tower','text':'The Eiffel Tower is an iron lattice tower in Paris, one of the most visited monuments.'},\n",
    "    {'title':'Grand Bazaar','text':'Grand Bazaar in Istanbul offers a rich shopping experience with historic architecture.'},\n",
    "    {'title':'Dubai Mall','text':'Dubai Mall features luxury shopping, an aquarium and is next to Burj Khalifa.'},\n",
    "]\n",
    "book_df = pd.DataFrame(travel_texts)\n",
    "book_df.head()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Embeddings (mock vectors) and simple vector store (pandas)\n",
    "We'll create deterministic pseudo-embeddings using md5 hashing mapped to float vectors. These will be used for semantic search (cosine similarity).\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def text_to_vector(text, dim=64):\n",
    "    h = hashlib.md5(text.encode('utf-8')).digest()\n",
    "    # expand to desired dim by repeating bytes and mapping to floats in [-1,1]\n",
    "    vals = []\n",
    "    i = 0\n",
    "    while len(vals) < dim:\n",
    "        byte = h[i % len(h)]\n",
    "        vals.append((byte / 255.0) * 2 - 1)\n",
    "        i += 1\n",
    "    return np.array(vals, dtype=float)\n",
    "# Build FAQ vector table\n",
    "faq_table = []\n",
    "for entry in faqs:\n",
    "    vec = text_to_vector(entry['question'] + ' ' + entry['answer'])\n",
    "    faq_table.append({'question':entry['question'],'answer':entry['answer'],'vector':vec})\n",
    "faq_df = pd.DataFrame(faq_table)\n",
    "# Build book vector table\n",
    "book_table = []\n",
    "for _, row in book_df.iterrows():\n",
    "    v = text_to_vector(row['title'] + ' ' + row['text'])\n",
    "    book_table.append({'title':row['title'],'text':row['text'],'vector':v})\n",
    "book_vec_df = pd.DataFrame(book_table)\n",
    "print('FAQ and Book vector tables created with', len(faq_df), 'and', len(book_vec_df), 'entries')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Utility: cosine similarity search over our mock vector tables" 
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from numpy.linalg import norm\n",
    "def cosine_sim(a,b):\n",
    "    if norm(a)==0 or norm(b)==0:\n",
    "        return 0.0\n",
    "    return float(np.dot(a,b)/(norm(a)*norm(b)))\n",
    "def search_table(query, table_df, topk=2):\n",
    "    qv = text_to_vector(query)\n",
    "    scores = []\n",
    "    for i,row in table_df.iterrows():\n",
    "        scores.append((i, cosine_sim(qv, row['vector'])))\n",
    "    scores.sort(key=lambda x: x[1], reverse=True)\n",
    "    results = []\n",
    "    for idx, sc in scores[:topk]:\n",
    "        r = table_df.loc[idx].to_dict()\n",
    "        r['score'] = sc\n",
    "        results.append(r)\n",
    "    return results\n",
    "# quick test\n",
    "print(search_table('What documents do I need for international travel?', faq_df, topk=2))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Define mock tools (functions)\n",
    "هر ابزار یک تابع پایتون است که ورودی‌ها را گرفته و پاسخ‌های ساختگی اما معقول برمی‌گرداند.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def flight_search(origin, destination, depart_date, return_date=None, adults=1):\n",
    "    # normalize cities to iata\n",
    "    o = city_to_iata.get(origin.lower(), origin.upper())\n",
    "    d = city_to_iata.get(destination.lower(), destination.upper())\n",
    "    # create 3 mock flights\n",
    "    flights = []\n",
    "    base_price = 100.0 + (abs(len(origin)-len(destination)))*10\n",
    "    for i in range(3):\n",
    "        flights.append({\n",
    "            'flight_number': f'XY{i+100}',\n",
    "            'airline_code': 'XY',\n",
    "            'price': round(base_price*(1+0.1*i),2),\n",
    "            'currency':'USD',\n",
    "            'departure': str(depart_date),\n",
    "            'duration':'{hours}h{mins}m'.format(hours=2+i, mins=15),\n",
    "            'stops': i\n",
    "        })\n",
    "    return flights\n",
    "\n",
    "def hotel_search(destination, checkin, checkout, budget=None):\n",
    "    # return 3 mock hotels\n",
    "    hotels = []\n",
    "    for i in range(3):\n",
    "        hotels.append({\n",
    "            'name': f'{destination.title()} Hotel {i+1}',\n",
    "            'rating': round(3.5 + 0.5*i,1),\n",
    "            'price_per_night': 80 + 40*i,\n",
    "            'currency': 'USD',\n",
    "            'address': f'Central {destination.title()}, Main St {i+1}'\n",
    "        })\n",
    "    return hotels\n",
    "\n",
    "def restaurant_search(destination, top_k=5):\n",
    "    sample = [\n",
    "        {'name':f'{destination.title()} Bistro','cuisine':'Local','desc':'A cozy place with local dishes.','url':'https://example.com/1'},\n",
    "        {'name':f'{destination.title()} Fine Dine','cuisine':'International','desc':'Fine dining with great views.','url':'https://example.com/2'},\n",
    "        {'name':f'{destination.title()} Cafe','cuisine':'Cafe','desc':'Light meals and coffee.','url':'https://example.com/3'},\n",
    "    ]\n",
    "    return sample[:top_k]\n",
    "\n",
    "def weather_search(destination, date):\n",
    "    # return mock forecast\n",
    "    return {'destination':destination,'date':str(date),'temp_c':22,'condition':'Partly cloudy','precip_prob':10,'advice':'Carry a light jacket'}\n",
    "\n",
    "def currency_rate(country_from, country_to):\n",
    "    # map countries to codes then return mock rate\n",
    "    a = country_to_currency.get(country_from.lower(), 'USD')\n",
    "    b = country_to_currency.get(country_to.lower(), 'USD')\n",
    "    # deterministic pseudo-rate based on hash\n",
    "    s = (int(hashlib.md5((a+b).encode()).hexdigest(),16) % 1000)/100.0\n",
    "    rate = round(1.0 + (s%5),3)\n",
    "    return f'1 {a} = {rate} {b}'\n",
    "\n",
    "def faq_search(query, topk=2):\n",
    "    results = search_table(query, faq_df, topk=topk)\n",
    "    out = 'Based on our FAQ:\n'\n",
    "    for r in results:\n",
    "        out += f"\nQ: {r['question']}\nA: {r['answer']}\n"\n",
    "    return out\n",
    "\n",
    "def plan_trip(destination, arrival_date, departure_date, interests=None):\n",
    "    # simple itinerary generator using book_vec_df and restaurant search\n",
    "    days = (departure_date - arrival_date).days + 1\n",
    "    itinerary = {}\n",
    "    for day in range(days):\n",
    "        d = arrival_date + pd.Timedelta(days=day)\n",
    "        # pick a book paragraph and restaurants\n",
    "        pick = book_vec_df.iloc[day % len(book_vec_df)].to_dict()\n",
    "        restaurants = restaurant_search(destination, top_k=2)\n",
    "        itinerary[str(d.date())] = {'attraction':pick['title'],'description':pick['text'],'restaurants':restaurants}\n",
    "    return itinerary\n",
    "\n",
    "print('Mock tools defined')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Simple CLI agent that routes user queries to mock tools\n",
    "استفاده از یک منطق ساده برای تشخیص intent و فراخوانی ابزار مناسب. این بخش جایگزین اجرای LangGraph می‌شود تا نوت‌بوک به صورت محلی اجرا شود.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def simple_agent(query):\n",
    "    q = query.lower()\n",
    "    # heuristics\n",
    "    if 'flight' in q or 'fly' in q or 'departure' in q:\n",
    "        # parse simple pattern: from X to Y on DATE\n",
    "        # very simple parsing for demo purposes\n",
    "        parts = q.split()\n",
    "        # fallback values\n",
    "        origin='tehran'\n",
    "        dest='dubai'\n",
    "        date = datetime.now().date() + timedelta(days=7)\n",
    "        flights = flight_search(origin,dest,date)\n",
    "        return {'tool':'flight_search','output':flights}\n",
    "    if 'hotel' in q or 'stay' in q or 'check-in' in q:\n",
    "        dest='paris'\n",
    "        ci = datetime.now().date()+timedelta(days=10)\n",
    "        co = ci + timedelta(days=3)\n",
    "        hotels = hotel_search(dest,ci,co)\n",
    "        return {'tool':'hotel_search','output':hotels}\n",
    "    if 'restaurant' in q or 'eat' in q or 'food' in q:\n",
    "        dest='istanbul'\n",
    "        res = restaurant_search(dest,top_k=3)\n",
    "        return {'tool':'restaurant_search','output':res}\n",
    "    if 'weather' in q or 'forecast' in q:\n",
    "        dest='dubai'\n",
    "        date = datetime.now().date()+timedelta(days=2)\n",
    "        w = weather_search(dest,date)\n",
    "        return {'tool':'weather_search','output':w}\n",
    "    if 'currency' in q or 'exchange' in q or 'convert' in q:\n",
    "        return {'tool':'currency_rate','output':currency_rate('iran','uae')}\n",
    "    # default: faq search\n",
    "    return {'tool':'faq_search','output':faq_search(query)}\n",
    "\n",
    "# interactive CLI function (for notebook use, we'll show example runs below)\n",
    "def chat_cli_example(queries):\n",
    "    for q in queries:\n",
    "        print('USER:',q)\n",
    "        res = simple_agent(q)\n",
    "        print('USED TOOL:',res['tool'])\n",
    "        print('OUTPUT:',res['output'])\n",
    "        print('-'*40)\n",
    "\n",
    "print('Simple agent ready')\n"
   ]
  },
  {
