   "source": [
    "# --- Simple CLI to interact with the mock agent ---\n",
    "def chat_cli():\n",
    "    print('Welcome to TravelBot (mock). Type exit to quit.')\n",
    "    while True:\n",
    "        q = input('You: ').strip()\n",
    "        if q.lower() in ('exit','quit'):\n",
    "            print('Goodbye!')\n",
    "            break\n",
    "        if q.lower().startswith('find flight'):\n",
    "            # expected format: find flight from X to Y on YYYY-MM-DD\n",
    "            m = re.search(r'from (.+) to (.+) on (\d{4}-\d{2}-\d{2})', q, re.I)\n",
    "            if m:\n",
    "                origin, dest, date = m.group(1), m.group(2), m.group(3)\n",
    "                print('Searching flights...')\n",
    "                for f in flight_search(origin,dest,date):\n",
    "                    print(f)\n",
    "            else:\n",
    "                print('Please use: find flight from <city> to <city> on YYYY-MM-DD')\n",
    "        elif q.lower().startswith('search faq'):\n",
    "            query = q[len('search faq'):].strip()\n",
    "            if not query: query = input('Enter FAQ query: ')\n",
    "            res = faq_search(query)\n",
    "            if not res:\n",
    "                print('No relevant FAQ found.')\n",
    "            else:\n",
    "                for r in res:\n",
    "                    print('Q:', r['question'])\n",
    "                    print('A:', r['answer'])\n",
    "        elif q.lower().startswith('plan trip'):\n",
    "            # plan trip to <destination> from <YYYY-MM-DD> to <YYYY-MM-DD>\n",
    "            m = re.search(r'plan trip to (.+) from (\d{4}-\d{2}-\d{2}) to (\d{4}-\d{2}-\d{2})', q, re.I)\n",
    "            if m:\n",
    "                dest, a, b = m.group(1), m.group(2), m.group(3)\n",
    "                it = plan_trip(dest, a, b)\n",
    "                print(json.dumps(it, indent=2, ensure_ascii=False))\n",
    "            else:\n",
    "                print('Please use: plan trip to <destination> from YYYY-MM-DD to YYYY-MM-DD')\n",
    "        else:\n",
    "            # fallback: try FAQ search first then book search\n",
    "            res = faq_search(q, limit=1)\n",
    "            if res:\n",
    "                print('FAQ answer:')\n",
    "                print(res[0]['answer'])\n",
    "            else:\n",
    "                bres = vector_search(book_df, q, topk=1)\n",
    "                if bres:\n",
    "                    print('From travel book:', bres[0]['title'])\n",
    "                    print(bres[0]['text'] if 'text' in bres[0] else bres[0]['score'])\n",
    "                else:\n",
    "                    print('Sorry, I could not find an answer.')\n",
    "\n",
    "# Uncomment to run the CLI in an interactive environment\n",
    "# chat_cli()\n",
    "print('Notebook setup complete. Call chat_cli() to interact.')\n"
   ]
  },
  {
