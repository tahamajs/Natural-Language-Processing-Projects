    "# --- Quick tests / examples ---\n",
    "print('Example flight search:')\n",
    "print(flight_search('Tehran','Dubai','2025-12-20'))\n",
    "print('\nExample FAQ search:')\n",
    "print(faq_search('What documents do I need for international travel?'))\n",
    "print('\nExample plan trip:')\n",
    "print(json.dumps(plan_trip('Paris','2025-12-18','2025-12-22'), indent=2, ensure_ascii=False))\n"
