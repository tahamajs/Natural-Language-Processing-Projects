   "source": [
    "# تراول‌بات — تمرین ۵ بخش دوم\n",
    "\n",
    "این نوت‌بوک نسخه تکمیل‌شده و قابل اجراست که شامل مراحل: بارگذاری داده‌ها، ساخت نقشه‌ها، ساخت امبدینگ‌ها، تعریف ابزارها (شبیه‌سازی‌شده) و رابط CLI برای تست است. تمام سلول‌های کد اجراپذیر هستند و برای اجرأ آفلاین از جایگزین‌های ساده‌شده استفاده شده است."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Install lightweight dependencies (uncomment to run)\n",
    "# %pip install -r requirements.txt\n",
    "from dotenv import load_dotenv\n",
    "import os, json, re\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timedelta\n",
    "from sentence_transformers import SentenceTransformer\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "load_dotenv()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Load / build city -> IATA mapping ---\n",
    "data_dir = Path('./data')\n",
    "data_dir.mkdir(exist_ok=True)\n",
    "city_to_iata = {}\n",
    "# Try to load an iata csv if present (from the original assignment), otherwise use a small fallback.\n",
    "iata_path = Path('./data/iata-airport-code/iata-airport-codes.csv')\n",
    "if iata_path.exists():\n",
    "    iata_df = pd.read_csv(iata_path)\n",
    "    for _, r in iata_df.dropna(subset=['city','iata_code']).iterrows():\n",
    "        city_to_iata[r['city'].strip().lower()] = r['iata_code'].strip().upper()\n",
    "else:\n",
    "    # fallback minimal mapping\n",
    "    city_to_iata = {'dubai':'DXB','tehran':'THR','tehran (imam khomeini)':'IKA','paris':'CDG','london':'LHR','new york':'JFK'}\n",
    "print('Loaded', len(city_to_iata), 'city->IATA mappings (sample):', list(city_to_iata.items())[:5])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Load / build country -> currency mapping ---\n",
    "country_to_currency = {}\n",
    "currency_path = Path('./data/currency-and-country-code-mapping/currency_country_code.csv')\n",
    "if currency_path.exists():\n",
    "    cur_df = pd.read_csv(currency_path)\n",
    "    for _, r in cur_df.dropna(subset=['Country','CurrencyCode']).iterrows():\n",
    "        country_to_currency[r['Country'].strip().lower()] = r['CurrencyCode'].strip().upper()\n",
    "else:\n",
    "    country_to_currency = {'iran':'IRR','united arab emirates':'AED','united states':'USD','france':'EUR','uk':'GBP'}\n",
    "print('Loaded', len(country_to_currency), 'country->currency mappings (sample):', list(country_to_currency.items())[:5])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Load FAQ.js (expects a JSON array in the file) ---\n",
    "faq_path = Path('FAQ.js')\n",
    "faq_list = []\n",
    "if faq_path.exists():\n",
    "    text = faq_path.read_text(encoding='utf-8')\n",
    "    # Try to extract the JSON array from the file contents\n",
    "    m = re.search(r"(\[\s*\{[\s\S]*\}\s*\])", text)\n",
    "    if m:\n",
    "        arr_text = m.group(1)\n",
    "        try:\n",
    "            faq_list = json.loads(arr_text)\n",
    "        except Exception:\n",
    "            # fallback: try single quotes to double\n",
    "            faq_list = json.loads(arr_text.replace("'", '"'))\n",
    "    else:\n",
    "        # try to parse entire file as JSON\n",
    "        try:\n",
    "            faq_list = json.loads(text)\n",
    "        except Exception:\n",
    "            faq_list = []\n",
    "else:\n",
    "    # fallback minimal FAQ\n",
    "    faq_list = [\n",
    "        {\"question\": \"What documents do I need for international travel?\", \"answer\": \"A valid passport, visa if required, travel insurance, and return ticket.\"},\n",
    "        {\"question\": \"How early should I arrive at the airport?\", \"answer\": \"3 hours for international, 2 hours for domestic.\"}\n",
    "    ]\n",
    "print('Loaded', len(faq_list), 'FAQ entries')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Build simple embeddings for FAQ and Book (if any) ---\n",
    "embed_model = SentenceTransformer('all-MiniLM-L6-v2')\n",
    "faq_texts = [f\"Q: {x['question']} A: {x['answer']}\" for x in faq_list]\n",
    "faq_embeddings = embed_model.encode(faq_texts, show_progress_bar=False)\n",
    "faq_df = pd.DataFrame({'question':[x['question'] for x in faq_list], 'answer':[x['answer'] for x in faq_list]})\n",
    "faq_df['embedding'] = list(faq_embeddings)\n",
    "print('FAQ embeddings shape:', len(faq_df))\n",
    "# Build a tiny "book" dataset as fallback if no PDF provided\n",
    "book_docs = [\n",
    "    {'title':'Paris highlights','text':'Eiffel Tower, Louvre, Montmartre and Seine river cruises.'},\n",
    "    {'title':'Dubai attractions','text':'Burj Khalifa, Dubai Mall, Palm Jumeirah, desert safari.'},\n",
    "    {'title':'Tehran points','text':'Golestan Palace, Grand Bazaar, Tabiat Bridge.'}\n",
    "]\n",
    "book_texts = [d['text'] for d in book_docs]\n",
    "book_embeddings = embed_model.encode(book_texts, show_progress_bar=False)\n",
    "book_df = pd.DataFrame(book_docs)\n",
    "book_df['embedding'] = list(book_embeddings)\n",
    "print('Book entries:', len(book_df))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Utility: vector search over a dataframe with 'embedding' column ---\n",
    "def vector_search(df, query, topk=3):\n",
    "    q_emb = embed_model.encode([query])[0]\n",
    "    embs = np.vstack(df['embedding'].values)\n",
    "    sims = cosine_similarity([q_emb], embs)[0]\n",
    "    idx = np.argsort(-sims)[:topk]\n",
    "    results = []\n",
    "    for i in idx:\n",
    "        row = df.iloc[i].to_dict()\n",
    "        row['score'] = float(sims[i])\n",
    "        results.append(row)\n",
    "    return results\n",
    "\n",
    "# --- Tools (lightweight implementations) ---\n",
    "def flight_search(origin, destination, date, limit=3):\n",
    "    o = city_to_iata.get(origin.strip().lower(), 'UNK')\n",
    "    d = city_to_iata.get(destination.strip().lower(), 'UNK')\n",
    "    # return mocked flights\n",
    "    flights = []\n",
    "    for i in range(limit):\n",
    "        flights.append({\n",
    "            'airline': f'Airline{i+1}',\n",
    "            'flight_number': f'A{i+100+i}',\n",
    "            'origin': o,\n",
    "            'destination': d,\n",
    "            'departure': date + 'T'+ f'{8+i}:00',\n",
    "            'arrival': date + 'T'+ f'{11+i}:30',\n",
    "            'duration_min': 210 + i*15,\n",
    "            'stops': 0 if i==0 else 1,\n",
    "            'price': f"{100 + i*50} USD"\n",
    "        })\n",
    "    return flights\n",
    "\n",
    "def hotel_search(destination, checkin, checkout, budget=None, limit=5):\n",
    "    # mocked hotels\n",
    "    hotels = []\n",
    "    for i in range(limit):\n",
    "        hotels.append({\n",
    "            'name': f'{destination.title()} Hotel {i+1}',\n",
    "            'rating': round(4.0 - i*0.3,1),\n",
    "            'price_per_night': f'{80 + i*30} USD',\n",
    "            'address': f'Center of {destination.title()}',\n",
    "        })\n",
    "    return hotels\n",
    "\n",
    "def restaurant_search(destination, limit=5):\n",
    "    # use web-like book data to craft descriptions\n",
    "    results = []\n",
    "    for i in range(limit):\n",
    "        results.append({\n",
    "            'name': f'{destination.title()} Eatery {i+1}',\n",
    "            'cuisine': 'Local',\n",
    "            'description': f'A popular spot in {destination.title()} serving local specialties.',\n",
    "            'url': 'https://example.com/' + destination.replace(' ','_')\n",
    "        })\n",
    "    return results\n",
    "\n",
    "def weather_info(destination, date):\n",
    "    # mocked simple forecast\n",
    "    return {\n",
    "        'destination': destination,\n",
    "        'date': date,\n",
    "        'temp_c': 20,\n",
    "        'condition': 'Partly cloudy',\n",
    "        'advice': 'Bring a light jacket'\n",
    "    }\n",
    "\n",
    "def currency_info(from_country, to_country):\n",
    "    a = country_to_currency.get(from_country.strip().lower(), 'USD')\n",
    "    b = country_to_currency.get(to_country.strip().lower(), 'USD')\n",
    "    # mocked rate\n",
    "    rate = 1.0 if a==b else 3.5\n",
    "    return f'1 {a} = {rate} {b}'\n",
    "\n",
    "def faq_search(query, limit=2):\n",
    "    return vector_search(faq_df, query, topk=limit)\n",
    "\n",
    "def plan_trip(destination, arrival_date, departure_date, interests=[]):\n",
    "    # basic itinerary using book_docs and restaurant_search\n",
    "    try:\n",
    "        d1 = datetime.fromisoformat(arrival_date)\n",
    "        d2 = datetime.fromisoformat(departure_date)\n",
    "    except Exception:\n",
    "        # try YYYY-MM-DD strings\n",
    "        d1 = datetime.strptime(arrival_date.split('T')[0], '%Y-%m-%d')\n",
    "        d2 = datetime.strptime(departure_date.split('T')[0], '%Y-%m-%d')\n",
    "    days = max(1, (d2 - d1).days)\n",
    "    res = {'destination':destination, 'days': days, 'itinerary': []}\n",
    "    for day in range(days):\n",
    "        res['itinerary'].append({\n",
    "            'day': day+1,\n",
    "            'morning': f'Visit main attractions of {destination}',\n",
    "            'afternoon': f'Lunch at local restaurant and museum',\n",
    "            'evening': f'Dinner and leisure'\n",
    "        })\n",
    "    return res\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
