            "source": [
                "from transformers import Trainer, TrainingArguments\n",
                "from trl import SFTTrainer\n",
                "import time\n",
                "import torch\n",
                "\n",
                "# Fix torch.get_default_device issue\n",
                "if hasattr(torch, '_GLOBAL_DEVICE_CONTEXT'):\n",
                "    if hasattr(torch._GLOBAL_DEVICE_CONTEXT, 'device_context'):\n",
                "        if torch._GLOBAL_DEVICE_CONTEXT.device_context is None:\n",
                "            delattr(torch._GLOBAL_DEVICE_CONTEXT, 'device_context')\n",
                "\n",
                "# Set device\n",
                "if torch.cuda.is_available():\n",
                "    device = \"cuda\"\n",
                "    use_fp16 = True\n",
                "else:\n",
                "    device = \"cpu\"\n",
                "    use_fp16 = False\n",
                "\n",
                "print(f\"🖥️ Using device: {device}\")\n",
                "\n",
                "# Create SFT Trainer\n",
                "print(\"🚀 Creating SFT Trainer...\")\n",
                "\n",
                "# Convert dataset to text\n",
                "def convert_to_text(example):\n",
                "    \"\"\"Convert messages to text using chat template\"\"\"\n",
                "    text = tokenizer.apply_chat_template(\n",
                "        example[\"messages\"],\n",
                "        tokenize=False,\n",
                "        add_generation_prompt=False\n",
                "    )\n",
                "    return {\"text\": text}\n",
                "\n",
                "print(\"🔄 Converting dataset to text format...\")\n",
                "train_dataset = dataset.map(convert_to_text, remove_columns=dataset.column_names)\n",
                "print(f\"✅ Conversion done. New columns: {train_dataset.column_names}\")\n",
                "\n",
                "# Training arguments already defined in previous cell\n",
                "\n",
                "# Tokenization function\n",
                "def tokenize_function(examples):\n",
                "    result = tokenizer(\n",
                "        examples[\"text\"],\n",
                "        truncation=True,\n",
                "        max_length=MAX_SEQ_LENGTH,\n",
                "        padding=\"max_length\",\n",
                "        return_tensors=None,\n",
                "    )\n",
                "    # add labels for causal LM\n",
                "    result[\"labels\"] = result[\"input_ids\"].copy()\n",
                "    return result\n",
                "\n",
                "print(\"🔄 Tokenizing dataset...\")\n",
                "tokenized_dataset = train_dataset.map(\n",
                "    tokenize_function,\n",
                "    batched=True,\n",
                "    remove_columns=[\"text\"],\n",
                ")\n",
                "print(f\"✅ Tokenization done.\")\n",
                "\n",
                "# Data Collator\n",
                "from transformers import DataCollatorForLanguageModeling\n",
                "data_collator = DataCollatorForLanguageModeling(\n",
                "    tokenizer=tokenizer,\n",
                "    mlm=False,\n",
                ")\n",
                "\n",
                "# Using PEFT model (model was turned into a PeftModel after LoRA)\n",
                "print(f\"📦 Model type: {type(model).__name__}\")\n",
                "\n",
                "trainer = Trainer(\n",
                "    model=model,  # This is the PEFT/LoRA model built earlier\n",
                "    args=training_args,\n",
                "    train_dataset=tokenized_dataset,\n",
                "    data_collator=data_collator,\n",
                ")\n",
                "\n",
                "print(\"✅ Trainer ready\")\n",
                "print(f\"   - Model: {type(model).__name__}\")\n",
                "print(f\"   - Training samples: {len(trainer.train_dataset)}\")\n",
                "print(f\"   - Steps per epoch: {len(trainer.train_dataset) // (training_args.per_device_train_batch_size * training_args.gradient_accumulation_steps)}\")\n",
                "\n",
                "# Inspect trainable params\n",
                "trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n",
                "total_params = sum(p.numel() for p in model.parameters())\n",
                "print(f\"   - Trainable params: {trainable_params:,} of {total_params:,} ({100*trainable_params/total_params:.2f}%)\")\n",
                "\n",
                "# Start training\n",
                "print(\"\\n\" + \"=\"*100)\n",
                "print(\"🎓 Starting training with LoRA...\")\n",
                "print(\"=\"*100)\n",
                "\n",
                "start_time = time.time()\n",
                "\n",
                "try:\n",
                "    train_result = trainer.train()\n",
                "\n",
                "    training_time = time.time() - start_time\n",
                "\n",
                "    print(\"\\n\" + \"=\"*100)\n",
                "    print(\"✅ Training completed successfully!\")\n",
                "    print(\"=\"*100)\n",
                "\n",
                "    print(f\"\\n📊 Training results:\")\n",
                "    print(f\"   - Total time: {training_time:.2f} seconds ({training_time/60:.2f} minutes)\")\n",
                "    print(f\"   - Training loss: {train_result.training_loss:.4f}\")\n",
                "    print(f\"   - Steps per second: {train_result.metrics['train_steps_per_second']:.2f}\")\n",
                "\n",
                "    trainer.log_metrics(\"train\", train_result.metrics)\n",
                "    trainer.save_metrics(\"train\", train_result.metrics)\n",
                "\n",
