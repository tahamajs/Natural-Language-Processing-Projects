            "source": [
                "from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training\n",
                "\n",
                "# Set up LoRA configuration\n",
                "print(\"⚙️ Setting up LoRA configuration...\")\n",
                "\n",
                "lora_config = LoraConfig(\n",
                "    r=16,                              # Rank: number of dimensions in low-rank matrices\n",
                "    lora_alpha=32,                     # Scaling factor (usually 2×r)\n",
                "    target_modules=[                   # Modules to apply LoRA on\n",
                "        \"q_proj\",                      # Query projection\n",
                "        \"k_proj\",                      # Key projection\n",
                "        \"v_proj\",                      # Value projection\n",
                "        \"o_proj\",                      # Output projection\n",
                "        \"gate_proj\",                   # Gate projection (for FFN)\n",
                "        \"up_proj\",                     # Up projection (for FFN)\n",
                "        \"down_proj\",                   # Down projection (for FFN)\n",
                "    ],\n",
                "    lora_dropout=0.05,                 # Dropout to prevent overfitting\n",
                "    bias=\"none\",                      # Bias training (none, all, lora_only)\n",
                "    task_type=\"CAUSAL_LM\"             # Task type\n",
                ")\n",
                "\n",
                "print(\"✅ LoRA configuration:\")\n",
                "print(f\"   - Rank (r): {lora_config.r}\")\n",
                "print(f\"   - Alpha: {lora_config.lora_alpha}\")\n",
                "print(f\"   - Dropout: {lora_config.lora_dropout}\")\n",
                "print(f\"   - Target modules: {lora_config.target_modules}\")\n",
                "\n",
                "# Apply LoRA\n",
                "print(\"\\n🔧 Applying LoRA to model...\")\n",
                "\n",
                "# Enable gradient checkpointing to reduce memory usage\n",
                "model.gradient_checkpointing_enable()\n",
                "\n",
                "# Prepare model for k-bit training\n",
                "model = prepare_model_for_kbit_training(model)\n",
                "\n",
                "# Apply LoRA\n",
                "model = get_peft_model(model, lora_config)\n",
                "\n",
                "# Show parameter stats\n",
                "model.print_trainable_parameters()\n",
                "\n",
                "# More precise calculation\n",
                "total_params = sum(p.numel() for p in model.parameters())\n",
                "trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n",
