        },
        {
            "cell_type": "markdown",
            "metadata": {
                "id": "LPzXPq4wtDHk"
            },
            "source": [
                "<div dir=\"rtl\" style=\"width: 98%; text-align: right; padding:10px; background-color:#6B7280;  border-radius: 12px; border: 2px solid rgb(2, 34, 22); font-family: Vazir;\">\n",
                "خروجی نسخه پایه و نسخه آموزش‌دیده مدل روی پرامپت‌های زیر را مقایسه نمایید.\n",
                "</div>"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {
                "id": "jbbjyMKFtDHl"
            },
            "outputs": [],
            "source": [
                "prompts = [\n",
                "    \"Create a slogan for a new vintage blues record collection app.\",\n",
                "    \"Create a slogan for a new vintage blues record collection app. The slogan should written in all capital letters.\",\n",
                "    \"Create a slogan for a new vintage blues record collection app. The slogan should written in all capital letters and end with the word soul.\",\n",
                "    \"Create a slogan for a new vintage blues record collection app. The slogan should written in all capital letters, end with the word soul, and contain exactly seven words.\",\n",
                "    \"Create a slogan for a new vintage blues record collection app. The slogan should written in all capital letters, end with the word soul, and contain exactly seven words. Wrap the entire answer in JSON format.\"\n",
                "]\n",
                "\n",
                "# Response generation function\n",
                "def generate_response(model, tokenizer, prompt, max_new_tokens=100):\n",
                "    \"\"\"Generate response using the model\"\"\"\n",
                "    # build conversation\n",
                "    messages = [\n",
                "        {\"role\": \"user\", \"content\": prompt}\n",
                "    ]\n",
                "\n",
                "    # Apply chat template\n",
                "    formatted_prompt = tokenizer.apply_chat_template(\n",
                "        messages,\n",
                "        tokenize=False,\n",
                "        add_generation_prompt=True\n",
                "    )\n",
                "\n",
                "    # Tokenize\n",
                "    inputs = tokenizer(formatted_prompt, return_tensors=\"pt\").to(device)\n",
                "\n",
                "    # Generate\n",
                "    with torch.no_grad():\n",
                "        outputs = model.generate(\n",
                "            **inputs,\n",
                "            max_new_tokens=max_new_tokens,\n",
                "            do_sample=True,\n",
                "            temperature=0.7,\n",
                "            top_p=0.9,\n",
                "            pad_token_id=tokenizer.eos_token_id\n",
                "        )\n",
                "\n",
                "    # Decode\n",
                "    generated_text = tokenizer.decode(outputs[0], skip_special_tokens=True)\n",
                "\n",
                "    # Extract only assistant response\n",
                "    if \"<|assistant|>\" in generated_text:\n",
                "        response = generated_text.split(\"<|assistant|>\")[-1].strip()\n",
                "    else:\n",
                "        response = generated_text.replace(formatted_prompt, \"\").strip()\n",
                "\n",
                "    return response\n",
                "\n",
                "# Load base model for comparison\n",
                "print(\"📥 Loading base model for comparison...\")\n",
                "base_model = AutoModelForCausalLM.from_pretrained(\n",
                "    model_name,\n",
                "    torch_dtype=torch.float16,\n",
                "    device_map=\"auto\"\n",
                ")\n",
                "print(\"✅ Base model loaded\")\n",
                "\n",
                "# Compare outputs\n",
                "print(\"\\n\" + \"=\"*100)\n",
                "print(\"🔍 Compare Base vs Fine-tuned models\")\n",
                "print(\"=\"*100)\n",
                "\n",
                "for i, prompt in enumerate(prompts, 1):\n",
                "    print(f\"\\n{'='*100}\")\n",
                "    print(f\"📝 Prompt {i}:\")\n",
                "    print(f\"{'='*100}\")\n",
                "    print(f\"{prompt}\\n\")\n",
                "\n",
                "    print(\"-\"*100)\n",
                "    print(\"🔵 Base Model:\")\n",
                "    print(\"-\"*100)\n",
                "    base_response = generate_response(base_model, tokenizer, prompt)\n",
                "    print(base_response)\n",
                "\n",
                "    print(\"\\n\" + \"-\"*100)\n",
                "    print(\"🟢 Fine-tuned Model:\")\n",
                "    print(\"-\"*100)\n",
                "    finetuned_response = generate_response(merged_model, tokenizer, prompt)\n",
                "    print(finetuned_response)\n",
                "\n",
                "    # Brief analysis\n",
                "    print(\"\\n\" + \"-\"*100)\n",
                "    print(\"📊 Analysis:\")\n",
                "    print(\"-\"*100)\n",
                "\n",
                "    # Check capital letters\n",
                "    if \"capital\" in prompt.lower():\n",
                "        base_caps = base_response.isupper() or any(word.isupper() for word in base_response.split())\n",
                "        ft_caps = finetuned_response.isupper() or any(word.isupper() for word in finetuned_response.split())\n",
                "        print(f\"   Capital letters: Base={base_caps}, Fine-tuned={ft_caps}\")\n",
                "\n",
                "    # Check final word\n",
                "    if \"end with\" in prompt.lower() and \"soul\" in prompt.lower():\n",
                "        base_ends = base_response.strip().lower().endswith(\"soul\")\n",
                "        ft_ends = finetuned_response.strip().lower().endswith(\"soul\")\n",
                "        print(f\"   Ends with 'soul': Base={base_ends}, Fine-tuned={ft_ends}\")\n",
                "\n",
                "    # Check word count\n",
                "    if \"seven words\" in prompt.lower():\n",
                "        base_words = len(base_response.split())\n",
                "        ft_words = len(finetuned_response.split())\n",
                "        print(f\"   Word count: Base={base_words}, Fine-tuned={ft_words} (target=7)\")\n",
                "\n",
                "    # Check JSON\n",
                "    if \"JSON\" in prompt:\n",
                "        base_json = \"{\" in base_response and \"}\" in base_response\n",
                "        ft_json = \"{\" in finetuned_response and \"}\" in finetuned_response\n",
                "        print(f\"   JSON format: Base={base_json}, Fine-tuned={ft_json}\")\n",
                "\n",
                "    print(\"\")\n",
                "\n",
                "print(\"\\n✅ Qualitative comparison complete!\")"
            ]
        },
        {
