            "source": [
                "# <div style=\"text-align: center; direction: rtl; font-family: Vazir;\"><h1 align=\"center\" style=\"font-size: 24px; padding: 20px;\">⚜️━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━⚜️<br>بهبود توانایی مدل های زبانی بزرگ در پیروی از دستورالعمل<br>⚜️━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━⚜️</h1></div>\n"
