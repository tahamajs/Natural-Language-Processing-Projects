            "source": [
                "# Save and merge LoRA weights\n",
                "\n",
                "import os\n",
                "\n",
                "# 1. Save LoRA adapter\n",
                "adapter_path = \"./tinyllama_lora_adapter\"\n",
                "print(f\"💾 Saving LoRA adapter to: {adapter_path}\")\n",
                "\n",
                "model.save_pretrained(adapter_path)\n",
                "tokenizer.save_pretrained(adapter_path)\n",
                "\n",
                "print(\"✅ LoRA adapter saved\")\n",
                "\n",
                "# Check adapter file size\n",
                "adapter_files = os.listdir(adapter_path)\n",
                "adapter_size = sum(\n",
                "    os.path.getsize(os.path.join(adapter_path, f))\n",
                "    for f in adapter_files\n",
                "    if os.path.isfile(os.path.join(adapter_path, f))\n",
                ")\n",
                "\n",
                "print(f\"📊 Adapter size: {adapter_size / (1024**2):.2f} MB\")\n",
                "print(f\"   Saved files: {adapter_files}\")\n",
                "\n",
                "# 2. Merge LoRA weights into base model\n",
                "print(f\"\\n🔄 Merging LoRA weights into the base model...\")\n",
                "\n",
                "# Merge\n",
                "merged_model = model.merge_and_unload()\n",
                "\n",
                "# Save merged model\n",
                "merged_path = \"./tinyllama_sft_merged\"\n",
                "print(f\"💾 Saving merged model to: {merged_path}\")\n",
                "\n",
                "merged_model.save_pretrained(\n",
                "    merged_path,\n",
                "    safe_serialization=True  # use safetensors\n",
                ")\n",
                "tokenizer.save_pretrained(merged_path)\n",
                "\n",
                "print(\"✅ Merged model saved\")\n",
                "\n",
                "# Check merged model size\n",
                "merged_files = os.listdir(merged_path)\n",
                "merged_size = sum(\n",
                "    os.path.getsize(os.path.join(merged_path, f))\n",
                "    for f in merged_files\n",
                "    if os.path.isfile(os.path.join(merged_path, f))\n",
                ")\n",
                "\n",
                "print(f\"📊 Merged model size: {merged_size / (1024**2):.2f} MB ({merged_size / (1024**3):.2f} GB)\")\n",
                "\n",
                "# 3. Compare sizes\n",
                "print(f\"\\n\" + \"=\"*100)\n",
                "print(\"📊 File size comparison:\")\n",
                "print(\"=\"*100)\n",
                "\n",
                "comparison = pd.DataFrame({\n",
                "    'Type': ['LoRA Adapter', 'Merged Model', 'Ratio'],\n",
                "    'Size': [\n",
                "        f\"{adapter_size / (1024**2):.2f} MB\",\n",
                "        f\"{merged_size / (1024**2):.2f} MB ({merged_size / (1024**3):.2f} GB)\",\n",
                "        f\"1 : {merged_size / adapter_size:.1f}\"\n",
                "    ]\n",
                "})\n",
                "\n",
                "print(comparison.to_string(index=False))\n",
                "\n",
                "print(f\"\\n💡 Notes:\")\n",
                "print(f\"   - Adapter is only ~{adapter_size / merged_size * 100:.2f}% the size of the full model\")\n",
                "print(f\"   - Adapter can be used for deployment (lighter)\")\n",
                "print(f\"   - For ease of use, the merged model is preferable\")\n",
                "print(f\"   - Multiple adapters can be used on the same base model\")\n",
                "\n",
                "print(\"\\n✅ Save completed!\")"
