            "source": [
                "# Evaluation with lm-evaluation-harness and ifeval\n",
                "\n",
                "print(\"📊 Evaluating models with IFEval benchmark\")\n",
                "print(\"=\"*100)\n",
                "\n",
                "# Installation and run steps (run in terminal)\n",
                "print(\"\\n🔧 Installation and run steps:\")\n",
                "print(\"-\"*100)\n",
                "\n",
                "install_commands = \"\"\"\n",
                "# 1. Clone repository\n",
                "git clone https://github.com/EleutherAI/lm-evaluation-harness\n",
                "cd lm-evaluation-harness\n",
                "pip install -e .\n",
                "\n",
                "# 2. Optional: install vLLM for speed\n",
                "pip install vllm\n",
                "\n",
                "# 3. Evaluate base model\n",
                "lm_eval --model hf \\\\\n",
                "    --model_args pretrained=TinyLlama/TinyLlama-1.1B-Chat-v1.0,dtype=float16 \\\\\n",
                "    --tasks ifeval \\\\\n",
                "    --batch_size 8 \\\\\n",
                "    --output_path ./eval_results_base \\\\\n",
                "    --log_samples\n",
                "\n",
                "# 4. Evaluate fine-tuned model\n",
                "lm_eval --model hf \\\\\n",
                "    --model_args pretrained=./tinyllama_sft_merged,dtype=float16 \\\\\n",
                "    --tasks ifeval \\\\\n",
                "    --batch_size 8 \\\\\n",
                "    --output_path ./eval_results_finetuned \\\\\n",
                "    --log_samples\n",
                "\n",
                "# 5. With vLLM (faster)\n",
                "lm_eval --model vllm \\\\\n",
                "    --model_args pretrained=./tinyllama_sft_merged,dtype=float16,gpu_memory_utilization=0.8 \\\\\n",
                "    --tasks ifeval \\\\\n",
                "    --batch_size 8 \\\\\n",
                "    --output_path ./eval_results_finetuned_vllm\n",
                "\"\"\"\n",
                "\n",
                "print(install_commands)\n",
                "\n",
                "print(\"\\n\" + \"=\"*100)\n",
                "print(\"📄 Expected sample output:\")\n",
                "print(\"=\"*100)\n",
                "\n",
                "# Simulated results (for display)\n",
                "sample_results = {\n",
                "    'Model': ['Base Model', 'Fine-tuned Model'],\n",
                "    'Prompt-Level Accuracy': [12.5, 45.8],\n",
                "    'Instruction-Level Accuracy': [35.2, 68.3],\n",
                "    'Strict Accuracy': [8.3, 38.9],\n",
                "    'Loose Accuracy': [18.7, 52.4]\n",
                "}\n",
                "\n",
                "results_df = pd.DataFrame(sample_results)\n",
                "\n",
                "print(\"\\n📊 Results comparison table:\")\n",
                "print(results_df.to_string(index=False))\n",
                "\n",
                "print(\"\\n\\n💡 Important notes:\")\n",
                "print(\"-\"*100)\n",
                "print(\"\"\"\n",
                "1. Evaluation may take 30-60 minutes (depending on hardware)\n",
                "2. Results are saved to JSON files\n",
                "3. --log_samples saves all inputs/outputs\n",
                "4. Use identical settings for fair comparison\n",
                "5. vLLM can be 2-3x faster but requires more VRAM\n",
                "\n",
                "📈 Interpreting results:\n",
                "- Prompt-Level Accuracy: main metric (must satisfy all constraints)\n",
                "- Instruction-Level Accuracy: complementary metric (each constraint separately)\n",
                "- A 20%+ improvement in Prompt-Level indicates successful fine-tuning\n",
                "- Base models often have <20%; fine-tuned models should be >40%\n",
                "\"\"\")\n",
                "\n",
                "print(\"\\n\" + \"=\"*100)\n",
                "print(\"📝 Python code to read and display results:\")\n",
                "print(\"=\"*100)\n",
                "\n",
                "analysis_code = \"\"\"\n",
                "import json\n",
                "import pandas as pd\n",
                "\n",
                "# Read results\n",
                "with open('./eval_results_base/results.json', 'r') as f:\n",
                "    base_results = json.load(f)\n",
                "\n",
                "with open('./eval_results_finetuned/results.json', 'r') as f:\n",
                "    ft_results = json.load(f)\n",
                "\n",
                "# Extract metrics\n",
                "comparison = {\n",
                "    'Metric': [],\n",
                "    'Base Model': [],\n",
                "    'Fine-tuned Model': [],\n",
                "    'Improvement': []\n",
                "}\n",
                "\n",
                "for metric in ['prompt_level_strict_acc', 'inst_level_strict_acc',\n",
                "               'prompt_level_loose_acc', 'inst_level_loose_acc']:\n",
                "    base_val = base_results['results']['ifeval'][metric]\n",
                "    ft_val = ft_results['results']['ifeval'][metric]\n",
                "    improvement = ((ft_val - base_val) / base_val * 100) if base_val > 0 else 0\n",
                "\n",
                "    comparison['Metric'].append(metric)\n",
                "    comparison['Base Model'].append(f\"{base_val:.2%}\")\n",
                "    comparison['Fine-tuned Model'].append(f\"{ft_val:.2%}\")\n",
                "    comparison['Improvement'].append(f\"+{improvement:.1f}%\")\n",
                "\n",
                "df = pd.DataFrame(comparison)\n",
                "print(df.to_string(index=False))\n",
                "\n",
                "# Save results\n",
                "df.to_csv('ifeval_comparison.csv', index=False)\n",
                "print(\"\\\\n✅ Results saved to ifeval_comparison.csv\")\n",
                "\"\"\"\n",
                "\n",
                "print(analysis_code)\n",
                "\n",
                "print(\"\\n✅ Evaluation guide ready!\")\n",
                "print(\"💾 Run these commands in terminal and report the results in the notebook\")"
            ]
        },
